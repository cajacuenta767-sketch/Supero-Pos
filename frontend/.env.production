# El modo demostración se declara explícitamente en falso.
#
# No basta con dejar la variable sin definir: Vite emite entonces
# `{}.VITE_DEMO_MODE === "true"`, un acceso a propiedad que el empaquetador no
# puede plegar, así que la rama sobrevive y las credenciales de ejemplo acaban
# dentro del bundle de producción. Con el valor presente queda
# `"false" === "true"`, que sí se resuelve y elimina el bloque entero.
VITE_DEMO_MODE=false
