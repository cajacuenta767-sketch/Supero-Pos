# Base de la API. Antes estaba escrita como http://localhost:3000 dentro del
# código, así que no había forma de apuntar a producción.
VITE_API_URL=http://localhost:3000/api/v1

# Modo demostración. Habilita el acceso sin backend con usuarios de ejemplo.
# DEBE quedar apagado en cualquier despliegue real: mientras esté activo, quien
# pueda dejar la terminal sin red entra con credenciales conocidas.
# Vite resuelve esta variable al compilar, así que con el modo apagado las
# credenciales no llegan siquiera al bundle.
VITE_DEMO_MODE=false

# PIN de supervisor de esta terminal, provisionado por instalación. Sin él, la
# autorización local se deniega en vez de aceptar un valor por defecto conocido.
VITE_SUPERVISOR_PIN=
