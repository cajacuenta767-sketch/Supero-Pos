# Secreto de firma de los tokens. Obligatorio en producción: sin él la API no
# arranca. Mínimo 32 caracteres. Genérelo con `openssl rand -hex 32`.
JWT_SECRET=

# Vigencia del token. 12h es el turno largo de una terminal.
JWT_EXPIRES_IN=12h

# Orígenes autorizados por CORS, separados por comas. La terminal Electron carga
# desde file:// y viaja sin cabecera Origin, así que no necesita figurar aquí.
CORS_ORIGINS=http://localhost:5173

# Tasa de IVA aplicada al desglose del ticket. Los precios se guardan con el
# impuesto incluido, así que el gravado se obtiene desde el total.
TAX_RATE=0.13

DATABASE_URL=postgresql://usuario:clave@localhost:5432/supero_pos
PORT=3000
